{
  "name": "@internal/figma-api-module-ts",
  "version": "1.0.0",
  "description": "Comprehensive collection of Figma API clients and SDKs (TypeScript edition)",
  "private": true,
  "type": "module",
  "workspaces": [
    "figma-fetch",
    "figma-fetch-file",
    "comments",
    "components",
    "dev-resources",
    "files",
    "find",
    "library-analytics",
    "projects",
    "variables",
    "webhooks"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:fetch": "npm run build --workspace=figma-fetch",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "figma",
    "api",
    "sdk",
    "client",
    "monorepo",
    "workspaces",
    "typescript"
  ],
  "author": "thinkeloquent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/figma/figma-api-module.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
