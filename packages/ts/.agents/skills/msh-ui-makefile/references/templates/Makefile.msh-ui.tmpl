##   {{PACKAGE_NAME}}   package name — package.json "name" (e.g. @internal/figma-file-health-metrics)
##   {{ORGANISM_DESC}}  one sentence naming the atomic-design organism and what it shows,
##                      wrapped across `##` lines — from the package README's opening
##   {{PORT}}           the organism's port — `ui-port-registry.sh --next`, then set the SAME
##                      number in vite.config.ts `server: { port: N, strictPort: true }` (UI-04)
##
## Everything below the knobs is the invariant core (UI-06): copy it verbatim.
## The only edits ever made to it are the `backend` prerequisites that the
## backend-block.tmpl fragment adds on `dev:`, `watch:` and `run-server:` (UI-10).
##
## After instantiating, run BOTH audits — this skill's and the house one:
##   scripts/ui-makefile-audit.sh <path>
##   ../makefile-self-improve/scripts/makefile-audit.sh <path>
## ============================================================================
##
## {{PACKAGE_NAME}} — vite dev-server Makefile
##
## Atomic-design organism: {{ORGANISM_DESC}} Targets manage the vite dev-server
## lifecycle (dev/stop/up/down/watch/status/logs/run-server) on PORT={{PORT}} via
## PID/log files; run-preview builds and serves the production bundle;
## typecheck/test run offline (tsc --noEmit, vitest). `make install` uses
## PKG_MANAGER (default pnpm).
##
SHELL := /bin/bash
.DEFAULT_GOAL := help
.ONESHELL:
.SHELLFLAGS := -euo pipefail -c

PKG_MANAGER ?= pnpm
PORT        ?= {{PORT}}
PID_FILE    := .dev.pid
LOG_FILE    := .dev.log

.PHONY: help install clean dev stop up down watch status logs typecheck test run-server run-preview audit

help: ## Show this help
	@awk 'BEGIN {FS = ":.*##"; printf "\nTargets:\n"} /^[a-zA-Z_-]+:.*##/ {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

install: ## Install dependencies
	$(PKG_MANAGER) install

clean: stop ## Remove build artifacts and logs
	rm -rf dist .vite $(LOG_FILE) $(PID_FILE)

dev: stop ## Start the vite dev server in the background
	@echo "starting vite on port $(PORT)..."
	@$(PKG_MANAGER) run dev > $(LOG_FILE) 2>&1 & echo $$! > $(PID_FILE)
	@sleep 1
	@echo "pid=$$(cat $(PID_FILE)) log=$(LOG_FILE)"
	@echo "host: http://localhost:$(PORT)"

watch: ## Start the vite dev server in the foreground
	$(PKG_MANAGER) run dev

stop: ## Stop the dev server (PID file > lsof > pkill)
	@if [ -f $(PID_FILE) ]; then \
	  pid=$$(cat $(PID_FILE)); \
	  kill $$pid 2>/dev/null || true; \
	  rm -f $(PID_FILE); \
	fi
	@pid=$$(lsof -ti tcp:$(PORT) 2>/dev/null || true); \
	if [ -n "$$pid" ]; then kill $$pid 2>/dev/null || true; fi
	@pkill -f "vite.*$(PORT)" 2>/dev/null || true
	@true

status: ## Show whether the dev server is running
	@if [ -f $(PID_FILE) ] && kill -0 $$(cat $(PID_FILE)) 2>/dev/null; then \
	  echo "running pid=$$(cat $(PID_FILE)) port=$(PORT)"; \
	else \
	  echo "stopped"; \
	fi

logs: ## Tail the dev server log
	@tail -f $(LOG_FILE)

up: install dev ## Install + start (docker-compose-style)
	@echo "up: http://localhost:$(PORT)"

down: stop ## Stop (docker-compose-style)
	@echo "down."

run-server: ## Run the dev server in the foreground (UI only — no backend)
	@echo "host: http://localhost:$(PORT)"
	$(PKG_MANAGER) run dev

run-preview: ## Build and serve the production bundle directly
	$(PKG_MANAGER) run build
	$(PKG_MANAGER) run preview

typecheck: ## Run tsc --noEmit
	$(PKG_MANAGER) run typecheck

test: ## Run vitest once
	$(PKG_MANAGER) run test

audit: typecheck test ## Offline gate: typecheck + test
