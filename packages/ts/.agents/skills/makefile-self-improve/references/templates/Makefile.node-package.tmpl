## ============================================================================
## PLACEHOLDER LEGEND — delete this whole block when instantiating.
##   {{PACKAGE_NAME}}       package name — package.json "name"
##   {{PACKAGE_DESC}}       one-line description — package.json "description"
##   {{TYPECHECK_COMMAND}}  typecheck invocation — scripts.typecheck, else `node --check` over sources
##   {{TEST_COMMAND}}       test invocation — scripts.test
##   {{RUN_COMMAND}}        run invocation — bin entry; if none, delete the optional run block
##   {{BUILD_DEP}}          build command(s) for workspace deps this package consumes
##                          (file: dependencies shipping built output); if none, delete the
##                          optional sdk block AND drop `sdk` from .PHONY, help, and `test:`
## Deleting an optional block: also remove its target name from .PHONY and the help body.
## ============================================================================
##
## {{PACKAGE_NAME}} — self-contained Makefile
##
## {{PACKAGE_DESC}}
##

.DEFAULT_GOAL := help

.PHONY: help install sdk typecheck test audit run clean

help: ## Show this help
	@echo "{{PACKAGE_NAME}} targets:"
	@echo "  make sdk         build the workspace packages this package depends on"
	@echo "  make test        run the test suite"
	@echo "  make typecheck   typecheck every source file"
	@echo "  make run         run the package"
	@echo "  make install     npm install"
	@echo "  make audit       typecheck + test"
	@echo "  make clean       remove node_modules / build output"

install: ## Install/link dependencies
	npm install

## --- optional block: workspace build dependency (delete if no {{BUILD_DEP}}) ---
sdk: ## Build the workspace packages this package consumes
	{{BUILD_DEP}}
## --- end optional block ---

typecheck: ## Typecheck every source file
	{{TYPECHECK_COMMAND}}

test: sdk ## Build workspace deps, then run the test suite
	{{TEST_COMMAND}}

## --- optional block: run target (delete if no {{RUN_COMMAND}}) ---
run: ## Run the package
	{{RUN_COMMAND}}
## --- end optional block ---

audit: typecheck test ## typecheck + test

clean: ## Remove node_modules / build output
	rm -rf node_modules dist out
